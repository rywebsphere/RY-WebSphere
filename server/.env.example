# RY WebSphere - Server Environment Configuration

PORT=5000
NODE_ENV=development

# Database Connection (Local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb+srv://ryadmin:Ranjanyadav123@cluster0.f5fiymi.mongodb.net/?compressors=zlib

# JWT Authentication Secret (Use a strong random key in production)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret_in_production

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# Initial Administrator Credentials (used by scripts/seed.js)
INITIAL_ADMIN_EMAIL=yadavranjan1626@gmail.com
INITIAL_ADMIN_PASSWORD=SetSecureAdminPassword2026!
INITIAL_ADMIN_NAME=Ranjan Yadav

# Official Business & Admin Notification Email
BUSINESS_EMAIL=rywebsphere@gmail.com
ADMIN_NOTIFICATION_EMAIL=rywebsphere@gmail.com
WHATSAPP_NUMBER=+917800462309

# Official Gmail SMTP Configuration
# Sender display: "RY WebSphere" <rywebsphere@gmail.com>
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=rywebsphere@gmail.com
# To generate a Gmail App Password:
# 1. Go to Google Account (rywebsphere@gmail.com) -> Security
# 2. Enable 2-Step Verification
# 3. Search "App Passwords" -> Create name: "RY WebSphere Mailer"
# 4. Copy the generated 16-character code (e.g., abcd efgh ijkl mnop) below:
EMAIL_PASS=your_16_char_gmail_app_password
EMAIL_FROM="RY WebSphere" <rywebsphere@gmail.com>

# Google Cloud Places API (Smart Lead Finder)
# Get your API key from Google Cloud Console -> APIs & Services -> Credentials
# Enable: "Places API" or "Places API (New)"
GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY
